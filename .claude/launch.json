{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "wing-night-mockups",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8793",
        "--bind",
        "127.0.0.1",
        "--directory",
        "apps/client/public"
      ],
      "port": 8793,
      "url": "http://127.0.0.1:8793"
    },
    {
      "name": "wing-night-party",
      "runtimeExecutable": "env",
      "runtimeArgs": ["PORT=3000", "fnm", "exec", "--using=25", "pnpm", "dev"],
      "port": 5173,
      "url": "http://localhost:5173"
    },
    {
      "name": "wing-night-portal",
      "runtimeExecutable": "fnm",
      "runtimeArgs": ["exec", "--using=25", "pnpm", "teaser:dev"],
      "port": 5173,
      "url": "http://localhost:5173"
    },
    {
      "name": "wing-night-second-server",
      "runtimeExecutable": "env",
      "runtimeArgs": ["PORT=3200", "fnm", "exec", "--using=25", "pnpm", "--filter", "@wingnight/server", "dev"],
      "port": 3200
    },
    {
      "name": "wing-night-second-client",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_SOCKET_SERVER_PORT=3200",
        "fnm",
        "exec",
        "--using=25",
        "pnpm",
        "--filter",
        "@wingnight/client",
        "exec",
        "vite",
        "--host",
        "--port",
        "5373",
        "--strictPort"
      ],
      "port": 5373,
      "url": "http://localhost:5373"
    },
    {
      "name": "wing-night-server",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=3902",
        "pnpm",
        "--filter",
        "@wingnight/server",
        "dev"
      ],
      "port": 3902
    },
    {
      "name": "wing-night-display",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_SOCKET_SERVER_URL=http://127.0.0.1:3902",
        "pnpm",
        "--filter",
        "@wingnight/client",
        "exec",
        "vite",
        "--host",
        "127.0.0.1",
        "--port",
        "5674",
        "--strictPort"
      ],
      "port": 5674,
      "url": "http://127.0.0.1:5674"
    },
    {
      "name": "wing-night-teaser",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@wingnight/client",
        "exec",
        "vite",
        "--config",
        "vite.teaser.config.ts",
        "--host",
        "127.0.0.1",
        "--port",
        "5676",
        "--strictPort"
      ],
      "port": 5676,
      "url": "http://127.0.0.1:5676"
    },
    {
      "name": "wing-night-teaser-dist",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@wingnight/client",
        "exec",
        "vite",
        "preview",
        "--config",
        "vite.teaser.config.ts",
        "--host",
        "127.0.0.1",
        "--port",
        "5677",
        "--strictPort"
      ],
      "port": 5677,
      "url": "http://127.0.0.1:5677"
    },
    {
      "name": "wing-night-lab-server",
      "runtimeExecutable": "env",
      "runtimeArgs": ["PORT=3300", "fnm", "exec", "--using=25", "pnpm", "--filter", "@wingnight/server", "dev"],
      "port": 3300
    },
    {
      "name": "wing-night-lab-client",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_SOCKET_SERVER_PORT=3300",
        "fnm",
        "exec",
        "--using=25",
        "pnpm",
        "--filter",
        "@wingnight/client",
        "exec",
        "vite",
        "--host",
        "--port",
        "5473",
        "--strictPort"
      ],
      "port": 5473,
      "url": "http://localhost:5473"
    }
  ]
}
