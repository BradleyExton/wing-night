{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "wing-night-server",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=3902",
        "pnpm",
        "--filter",
        "@wingnight/server",
        "dev"
      ],
      "port": 3902
    },
    {
      "name": "wing-night-display",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_SOCKET_SERVER_URL=http://127.0.0.1:3902",
        "pnpm",
        "--filter",
        "@wingnight/client",
        "exec",
        "vite",
        "--host",
        "127.0.0.1",
        "--port",
        "5674",
        "--strictPort"
      ],
      "port": 5674,
      "url": "http://127.0.0.1:5674"
    },
    {
      "name": "wing-night-teaser",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@wingnight/client",
        "exec",
        "vite",
        "--config",
        "vite.teaser.config.ts",
        "--host",
        "127.0.0.1",
        "--port",
        "5676",
        "--strictPort"
      ],
      "port": 5676,
      "url": "http://127.0.0.1:5676"
    },
    {
      "name": "wing-night-teaser-dist",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@wingnight/client",
        "exec",
        "vite",
        "preview",
        "--config",
        "vite.teaser.config.ts",
        "--host",
        "127.0.0.1",
        "--port",
        "5677",
        "--strictPort"
      ],
      "port": 5677,
      "url": "http://127.0.0.1:5677"
    }
  ]
}
