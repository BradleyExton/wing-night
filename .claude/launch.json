{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "wing-night-server",
      "runtimeExecutable": "env",
      "runtimeArgs": ["PORT=3700", "pnpm", "--filter", "@wingnight/server", "dev"],
      "port": 3700
    },
    {
      "name": "wing-night-display",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_SOCKET_SERVER_URL=http://127.0.0.1:3700",
        "pnpm",
        "--filter",
        "@wingnight/client",
        "exec",
        "vite",
        "--host",
        "127.0.0.1",
        "--port",
        "5873",
        "--strictPort"
      ],
      "port": 5873,
      "url": "http://127.0.0.1:5873"
    }
  ]
}
