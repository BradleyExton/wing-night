.dev.vars
.dev.vars.*
.wrangler/
playwright-report/
test-results/
.playwright/
# Scratch target for the PR-screenshot recipe in README.md and the PR template.
output/
# The preview stacks in .claude/launch.json are shared; per-machine Claude
# settings are not.
.claude/settings.local.json
