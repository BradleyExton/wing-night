// PROTOTYPE — throwaway (docs/minigames/base-borden-spec.md §0.7 step 1): the online jump lab,
// a Worker of its own on workers.dev so the live site is never touched by it. Deploy with
// `pnpm lab:deploy` from the repo root; deleting the lab deletes this file, src/labWorker.ts,
// src/labRoom/ and the Worker itself (`wrangler delete -c wrangler.lab.jsonc`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wingnight-lab",
  "main": "src/labWorker.ts",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "assets": {
    "directory": "../client/dist-lab",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/room/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "LAB_ROOM", "class_name": "RunGunLabRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RunGunLabRoom"] }]
}
