{
  // The tests, their node:sqlite-backed fakes and the seed script, all run on Node. They import
  // the handlers, which reach no workerd-only global, so Node's types cover everything here.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["src/**/*.test.ts", "src/testing/**/*.ts", "scripts/**/*.ts"]
}
