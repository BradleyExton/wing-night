{
  "name": "@wingnight/minigames-geo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/runtime/index.ts",
  "types": "src/runtime/index.ts",
  "exports": {
    ".": {
      "types": "./src/runtime/index.ts",
      "default": "./src/runtime/index.ts"
    },
    "./runtime": {
      "types": "./src/runtime/index.ts",
      "default": "./src/runtime/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./dev": {
      "types": "./src/dev/index.ts",
      "default": "./src/dev/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint src/**/*.{ts,tsx}",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/**/*.test.ts src/**/*.test.tsx"
  },
  "dependencies": {
    "@wingnight/minigames-core": "workspace:*",
    "@wingnight/shared": "workspace:*",
    "leaflet": "^1.9.4",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  }
}
