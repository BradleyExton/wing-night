{
  "name": "wing-night",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": "25.x"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @wingnight/server --filter @wingnight/client dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && pnpm test:lint-rules",
    "test:e2e": "playwright test",
    "test:lint-rules": "node --test tools/eslint-plugin-wingnight/tests/index.test.mjs",
    "import:geo": "node tools/import-geo-photos/index.mjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.58.2",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "typescript-eslint": "^8.21.0"
  }
}
